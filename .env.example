# Copy to .env and fill in ONE model section. It is loaded automatically;
# variables already set in the environment take precedence.

# --- model (required) --------------------------------------------------------

# OpenAI
LOVIA_MODEL=openai:gpt-5.5
OPENAI_API_KEY=sk-...

# Anthropic
# LOVIA_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Any OpenAI-compatible service: a bare model name + the service's base URL.
# DeepSeek:
# LOVIA_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# Ollama on this machine (the key is required but unused):
# LOVIA_MODEL=qwen3
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# --- server (optional) -------------------------------------------------------

# LOVIA_MU_DATA=data        # accounts, audit log, cookie secret, per-user data
# LOVIA_MU_HOST=127.0.0.1   # 0.0.0.0 to listen on every interface
# LOVIA_MU_PORT=8000
# LOVIA_MU_SECURE=1         # behind HTTPS: send the session cookie only over TLS
